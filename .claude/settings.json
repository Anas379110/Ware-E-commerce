{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(python manage.py *)",
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf /*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "notes": "إعدادات مشتركة لكل من يعمل على المشروع عبر Claude Code. الإعدادات الشخصية تُضاف في settings.local.json وليس هنا."
}
