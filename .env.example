# .env.example — انسخ هذا الملف إلى .env وامْلأ القيم الفعلية. لا تَرفع .env أبداً لـ Git.

# Django
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=

# Database
DATABASE_URL=postgres://user:password@host:5432/ware

# Redis
REDIS_URL=redis://host:6379/0

# JWT
JWT_SIGNING_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# شام كاش (تُستكمل فور استلام التوثيق الرسمي)
SHAM_CASH_API_KEY=
SHAM_CASH_WEBHOOK_SECRET=

# Email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend
NUXT_PUBLIC_API_BASE_URL=
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
